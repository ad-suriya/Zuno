# Backend settings. Copy to .env (make setup does this). Never commit .env.
# Locally, `make backend` loads this file. On Cloud Run, plain settings are set as
# service env vars and secrets (API keys) are injected from Secret Manager.

ENVIRONMENT=local

# Sarvam (STT / TTS / Indic language). Without a key, voice is disabled and users type instead.
SARVAM_API_KEY=
# Optional model overrides; empty = Sarvam's current default (e.g. saaras:v3, bulbul:v3).
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
# Voice requests allowed per client IP per minute (protects the API quota).
VOICE_RATE_PER_MINUTE=20

# Google Cloud project. Leave empty locally (defaults to zuno-local for the emulator).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1

# Gemini on Vertex AI (F04). Auth is Application Default Credentials
# (`gcloud auth application-default login` locally; the service account on Cloud Run).
# With LLM_ENABLED=false (default) every AI feature uses its deterministic fallback.
LLM_ENABLED=false
# Pick the current fast Gemini model available on Vertex AI in GOOGLE_CLOUD_REGION.
GEMINI_MODEL=

# Database — GCP Firestore (Native mode). Uses GOOGLE_CLOUD_PROJECT above.
FIRESTORE_DATABASE=(default)
# Local dev only: point the client at the emulator
# (gcloud emulators firestore start --host-port=localhost:8080). Leave unset in production.
FIRESTORE_EMULATOR_HOST=localhost:8080

# Local demo without the emulator: REPOSITORY=memory keeps data in the backend process
# (lost on restart; ignored on Cloud Run). Default: firestore.
REPOSITORY=firestore

# Cloud Storage (temporary evidence)
EVIDENCE_BUCKET=

# Backend: comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend settings live in frontend/.env.example (Next.js only reads env files from frontend/).
